# Copy this file to .env (git-ignored) and fill in the values.
# The back end, the Watcher and the scripts read .env automatically.
# Anything you `export` in the terminal overrides this file.

# --- AI: Gemini (leave the key empty to run without AI) ---
GEMINI_API_KEY=
# A model your key can use. List them with the command in docs/runbook.md, section 3.
GEMINI_MODEL=
# How much Gemini thinks before answering (low = fast). Leave empty for the model's default.
GEMINI_THINKING_LEVEL=low
# Seconds before an AI call gives up and the app answers from its template.
UNCLAIMED_AI_TIMEOUT=30

# --- AI: Claude instead (optional) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# If both are configured, choose one:
# UNCLAIMED_LLM_PROVIDER=gemini

# --- Review tool login (http://localhost:8000/admin) ---
ADMIN_USER=manoj
ADMIN_PASSWORD=

# --- Only needed when hosted (local defaults work on your Mac) ---
# DATABASE_URL=postgres://user:password@host:5432/dbname
# WEB_ORIGINS=https://your-phone-app.vercel.app,https://your-website.vercel.app
